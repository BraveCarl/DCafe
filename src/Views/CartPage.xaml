<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiStoreApp.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:converters="clr-namespace:MauiStoreApp.Converters"
    xmlns:local="clr-namespace:MauiStoreApp.ViewModels"
    xmlns:model="clr-namespace:MauiStoreApp.Models"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    xmlns:viewmodel="clr-namespace:MauiStoreApp.ViewModels"
    BackgroundColor="#0D0705">

    <Shell.TitleView>
        <Grid HorizontalOptions="FillAndExpand" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>

            <ActivityIndicator
                Grid.Column="0"
                HeightRequest="18"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusyWithCartModification}"
                VerticalOptions="Center"
                WidthRequest="18"
                Color="#C9A96E" />

            <StackLayout Grid.Column="1" VerticalOptions="Center">
                <Label
                    Text="Your Order"
                    FontSize="10"
                    TextColor="#7A6650"
                    FontFamily="AstoreEczarSemiBold"
                    HorizontalOptions="Center"/>
                <Label
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="My " TextColor="#C9A96E" FontAttributes="Bold" />
                            <Span Text="Cart" TextColor="#F5EDD8" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </StackLayout>

            <Frame
                Grid.Column="2"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                BackgroundColor="#1E1208"
                BorderColor="#2E1C0E"
                Padding="0"
                VerticalOptions="Center"
                IsVisible="{Binding CartItems.Count, Converter={StaticResource IntToBoolConverter}}">
                <ImageButton
                    BackgroundColor="Transparent"
                    Command="{Binding DeleteCartCommand}"
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    Source="delete_white.svg"
                    WidthRequest="36" />
            </Frame>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FirstLetterUppercaseConverter x:Key="FirstLetterUppercaseConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IntToBoolInvertedConverter x:Key="IntToBoolInvertedConverter" />
            <toolkit:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior Command="{Binding InitCommand}" EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logged-in content -->
        <Grid IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cart items list (user logged in) -->
            <ScrollView
                Grid.Row="0"
                IsVisible="{Binding IsUserLoggedIn}">
                <StackLayout Padding="16,12,16,24" Spacing="0">

                    <!-- Cart items -->
                    <CollectionView
                        IsVisible="{Binding CartItems.Count, Converter={StaticResource IntToBoolConverter}}"
                        ItemsSource="{Binding CartItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:CartItemDetail">
                                <Frame
                                    Margin="0,0,0,12"
                                    Padding="0"
                                    BackgroundColor="#1A0E08"
                                    BorderColor="#2E1C0E"
                                    CornerRadius="20"
                                    HasShadow="False">
                                    <Grid Padding="14" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: info -->
                                        <StackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">

                                            <!-- Category chip -->
                                            <Frame
                                                Padding="8,4"
                                                BackgroundColor="#120A04"
                                                BorderColor="#2E1C0E"
                                                CornerRadius="12"
                                                HorizontalOptions="Start">
                                                <StackLayout Orientation="Horizontal" Spacing="4">
                                                    <Label
                                                        FontFamily="AstoreEczarSemiBold"
                                                        FontSize="11"
                                                        Text="{Binding Product.Category, Converter={StaticResource FirstLetterUppercaseConverter}}"
                                                        TextColor="#C9A96E"
                                                        VerticalTextAlignment="Center" />
                                                    <Image
                                                        HeightRequest="10"
                                                        Source="arrow_next_small.svg"
                                                        VerticalOptions="Center"
                                                        WidthRequest="10" />
                                                </StackLayout>
                                            </Frame>

                                            <!-- Product title -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="AstoreEczarSemiBold"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                MaxLines="2"
                                                Text="{Binding Product.Title}"
                                                TextColor="#F5EDD8" />

                                            <!-- Price -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="AstoreEczarSemiBold"
                                                FontSize="16"
                                                Text="{Binding Product.Price, StringFormat='₱{0:F2}'}"
                                                TextColor="#C9A96E" />

                                            <!-- Quantity controls -->
                                            <Frame
                                                Padding="4"
                                                BackgroundColor="#120A04"
                                                BorderColor="#2E1C0E"
                                                CornerRadius="12"
                                                HorizontalOptions="Start">
                                                <Grid ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>

                                                    <ImageButton
                                                        Grid.Column="0"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CartViewModel}}, Path=DecreaseProductQuantityCommand}"
                                                        CommandParameter="{Binding Product}"
                                                        HeightRequest="32"
                                                        Source="minus.svg"
                                                        VerticalOptions="Center"
                                                        WidthRequest="32" />

                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontFamily="AstoreEczarSemiBold"
                                                        FontSize="14"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding Quantity}"
                                                        TextColor="#F5EDD8"
                                                        VerticalTextAlignment="Center" />

                                                    <ImageButton
                                                        Grid.Column="2"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CartViewModel}}, Path=IncreaseProductQuantityCommand}"
                                                        CommandParameter="{Binding Product}"
                                                        HeightRequest="32"
                                                        Source="plus.svg"
                                                        VerticalOptions="Center"
                                                        WidthRequest="32" />
                                                </Grid>
                                            </Frame>
                                        </StackLayout>

                                        <!-- Right: product image -->
                                        <Frame
                                            Grid.Column="1"
                                            Padding="0"
                                            BackgroundColor="#120A04"
                                            BorderColor="#2E1C0E"
                                            CornerRadius="16"
                                            HeightRequest="100"
                                            WidthRequest="100">
                                            <Image
                                                Margin="12"
                                                Aspect="AspectFit"
                                                HeightRequest="76"
                                                Source="{Binding Product.Image}"
                                                WidthRequest="76" />
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                        Text="Proceed to Checkout"
                        Command="{Binding GoToCheckoutCommand}"
                        IsVisible="{Binding HasCartItems}"
                        BackgroundColor="#C9A96E"
                        TextColor="#0D0705"
                        FontAttributes="Bold"
                        FontFamily="AstoreEczarSemiBold"
                        CornerRadius="14"
                        HeightRequest="52"
                        Margin="12,0,12,16" />

                    <!-- Empty cart state -->
                    <StackLayout
                        IsVisible="{Binding CartItems.Count, Converter={StaticResource IntToBoolInvertedConverter}}"
                        Padding="20,60,20,20"
                        Spacing="16"
                        VerticalOptions="CenterAndExpand">

                        <Frame
                            WidthRequest="100"
                            HeightRequest="100"
                            CornerRadius="50"
                            BackgroundColor="#1A0E08"
                            BorderColor="#2E1C0E"
                            HorizontalOptions="Center"
                            Padding="0">
                            <Image
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Source="empty_ghost.svg"
                                HeightRequest="54"
                                WidthRequest="54" />
                        </Frame>

                        <Label
                            FontAttributes="Bold"
                            FontFamily="AstoreEczarSemiBold"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="Nothing here yet"
                            TextColor="#F5EDD8" />

                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Your cart is empty. Browse our menu and add something delicious."
                            TextColor="#7A6650"
                            FontSize="13"
                            FontFamily="AstoreEczarSemiBold" />

                        <Button
                            Margin="0,20,0,0"
                            Command="{Binding GoToRouteCommand}"
                            CommandParameter="HomePage"
                            CornerRadius="14"
                            HorizontalOptions="Center"
                            BackgroundColor="#C9A96E"
                            TextColor="#0D0705"
                            FontAttributes="Bold"
                            FontFamily="AstoreEczarSemiBold"
                            FontSize="14"
                            Text="Browse Menu"
                            WidthRequest="160"
                            HeightRequest="46" />

                    </StackLayout>
                </StackLayout>
            </ScrollView>

 
            
            <!-- Not logged in state -->
            <StackLayout
                IsVisible="{Binding IsUserLoggedIn, Converter={StaticResource InvertedBoolConverter}}"
                Padding="32,60,32,32"
                Spacing="16"
                VerticalOptions="CenterAndExpand">

                <Frame
                    WidthRequest="110"
                    HeightRequest="110"
                    CornerRadius="55"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    HorizontalOptions="Center"
                    Padding="0">
                    <Image
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Source="not_logged_in.svg"
                        HeightRequest="60"
                        WidthRequest="60" />
                </Frame>

                <Label
                    FontAttributes="Bold"
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="Sign in to continue"
                    TextColor="#F5EDD8" />

                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="Log in to view your cart and place orders."
                    TextColor="#7A6650"
                    FontSize="13"
                    FontFamily="AstoreEczarSemiBold" />

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="#2E1C0E" Margin="0,12" />

                <Button
                    Command="{Binding GoToLoginPageCommand}"
                    CornerRadius="14"
                    HorizontalOptions="Center"
                    BackgroundColor="#C9A96E"
                    TextColor="#0D0705"
                    FontAttributes="Bold"
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="14"
                    Text="Sign In"
                    WidthRequest="160"
                    HeightRequest="46" />

              
            </StackLayout>
        </Grid>

        <ActivityIndicator
            HorizontalOptions="CenterAndExpand"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            Color="#C9A96E" />
    </Grid>
</ContentPage>
