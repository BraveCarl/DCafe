<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiStoreApp.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:local="clr-namespace:MauiStoreApp.ViewModels"
    xmlns:model="clr-namespace:MauiStoreApp.Models"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:DataType="local:ProfilePageViewModel"
    BackgroundColor="#0D0705">

    <Shell.TitleView>
        <Grid HorizontalOptions="FillAndExpand" Padding="16,0">
            <StackLayout VerticalOptions="Center">
                <Label
                    Text="Your profile"
                    FontSize="10"
                    TextColor="#7A6650"
                    FontFamily="AstoreEczarSemiBold"
                    HorizontalOptions="Center"/>
                <Label FontSize="18" HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="My " TextColor="#C9A96E" FontAttributes="Bold" FontFamily="AstoreEczarSemiBold" />
                            <Span Text="Account" TextColor="#F5EDD8" FontAttributes="Bold" FontFamily="AstoreEczarSemiBold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </StackLayout>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior Command="{Binding InitCommand}" EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
            <StackLayout Padding="16,16,16,32" Spacing="0">

                <!-- User profile card (logged in) -->
                <Frame
                    IsVisible="{Binding IsUserLoggedIn}"
                    Margin="0,0,0,16"
                    Padding="20"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    CornerRadius="20"
                    HasShadow="False">
                    <StackLayout Spacing="0">
                        <!-- Avatar + name row -->
                        <StackLayout Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
                            <Frame
                                Padding="0"
                                BackgroundColor="#C9A96E"
                                BorderColor="Transparent"
                                CornerRadius="26"
                                HasShadow="False"
                                HeightRequest="52"
                                WidthRequest="52">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="AstoreEczarSemiBold"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Text="{Binding User.AvatarInitials}"
                                    TextColor="#0D0705"
                                    VerticalOptions="Center" />
                            </Frame>

                            <StackLayout VerticalOptions="Center" Spacing="3" HorizontalOptions="StartAndExpand">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="AstoreEczarSemiBold"
                                    FontSize="18"
                                    Text="{Binding User.FullName}"
                                    TextColor="#F5EDD8" />
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Image
                                        Source="location_yellow.svg"
                                        HeightRequest="14"
                                        WidthRequest="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontFamily="AstoreEczarSemiBold"
                                        FontSize="13"
                                        Text="{Binding User.City}"
                                        TextColor="#7A6650"
                                        VerticalTextAlignment="Center" />
                                </StackLayout>
                            </StackLayout>
                        </StackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="#2E1C0E" Margin="0,0,0,14" />

                        <!-- Address details -->
                        <Label
                            FontAttributes="Bold"
                            FontFamily="AstoreEczarSemiBold"
                            FontSize="11"
                            Text="DELIVERY ADDRESS"
                            TextColor="#7A6650"
                            Margin="0,0,0,8" />
                        <Label Text="{Binding User.Street}" TextColor="#F5EDD8" FontFamily="AstoreEczarSemiBold" FontSize="13" />
                        <Label Text="{Binding User.City}" TextColor="#7A6650" FontFamily="AstoreEczarSemiBold" FontSize="13" />
                        <Label Text="{Binding User.Province}" TextColor="#7A6650" FontFamily="AstoreEczarSemiBold" FontSize="13" />
                        <Label Text="{Binding User.Phone}" TextColor="#7A6650" FontFamily="AstoreEczarSemiBold" FontSize="13" Margin="0,2,0,0" />
                    </StackLayout>
                </Frame>

                <!-- Account section -->
                <Label
                    Text="Account"
                    FontAttributes="Bold"
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="11"
                    TextColor="#7A6650"
                    Margin="4,0,0,10" />

                <Frame
                    Margin="0,0,0,16"
                    Padding="0"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    CornerRadius="16"
                    HasShadow="False">
                    <StackLayout Spacing="0">


                        <Grid
    Padding="18,16"
    IsVisible="{Binding IsUserLoggedIn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
        Grid.Column="0"
        FontAttributes="Bold"
        FontFamily="AstoreEczarSemiBold"
        FontSize="15"
        Text="View Orders"
        TextColor="#F5EDD8"
        VerticalOptions="Center" />
                            <Image
        Grid.Column="1"
        Aspect="AspectFit"
        Source="arrow_next_small.svg"
        WidthRequest="18"
        VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewOrdersCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Divider between View Orders and Edit Profile -->
                        <BoxView
    HeightRequest="1"
    Color="#2E1C0E"
    IsVisible="{Binding IsUserLoggedIn}"
    Margin="18,0" />
                        
                        <!-- ══ FIX: Edit Profile row — was completely missing ══
                             GoToEditProfileCommand exists in the ViewModel but
                             had no corresponding UI element in this XAML.
                             Only visible when logged in. -->
                        <Grid
                            Padding="18,16"
                            IsVisible="{Binding IsUserLoggedIn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="Edit Profile"
                                TextColor="#F5EDD8"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="arrow_next_small.svg"
                                WidthRequest="18"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Divider between Edit and Sign out -->
                        <BoxView
                            HeightRequest="1"
                            Color="#2E1C0E"
                            IsVisible="{Binding IsUserLoggedIn}"
                            Margin="18,0" />

                        <!-- Sign in (not logged in) -->
                        <Grid
                            Padding="18,16"
                            IsVisible="{Binding IsUserLoggedIn, Converter={StaticResource InvertedBoolConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="Sign in"
                                TextColor="#F5EDD8"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="login.svg"
                                WidthRequest="22"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LoginCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Sign out (logged in) -->
                        <Grid
                            Padding="18,16"
                            IsVisible="{Binding IsUserLoggedIn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="Sign out"
                                TextColor="#F5EDD8"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="logout.svg"
                                WidthRequest="22"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Divider -->
                        <BoxView
                            HeightRequest="1"
                            Color="#2E1C0E"
                            IsVisible="{Binding IsUserLoggedIn}"
                            Margin="18,0" />

                        <!-- Delete account (logged in) -->
                        <Grid
                            Padding="18,16"
                            IsVisible="{Binding IsUserLoggedIn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="Delete account"
                                TextColor="#E57373"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="delete_red.svg"
                                WidthRequest="22"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- About section -->
                <Label
                    Text="About the app"
                    FontAttributes="Bold"
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="11"
                    TextColor="#7A6650"
                    Margin="4,0,0,10" />

                <Frame
                    Margin="0,0,0,8"
                    Padding="0"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    CornerRadius="16"
                    HasShadow="False">
                    <StackLayout Spacing="0">

                        <Grid Padding="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="The Developer"
                                TextColor="#F5EDD8"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="arrow_next_small.svg"
                                WidthRequest="18"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeveloperCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#2E1C0E" Margin="18,0" />

                        <Grid Padding="18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="AstoreEczarSemiBold"
                                FontSize="15"
                                Text="Github"
                                TextColor="#F5EDD8"
                                VerticalOptions="Center" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="arrow_next_small.svg"
                                WidthRequest="18"
                                VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenGithubCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </StackLayout>
                </Frame>

                <Label
                    HorizontalOptions="Center"
                    Margin="0,12,0,0"
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="11"
                    Text="DCafé · Powered by BSIT student from CTU "
                    TextColor="#4A3828" />

            </StackLayout>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="CenterAndExpand"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            Color="#C9A96E" />
    </Grid>
</ContentPage>
