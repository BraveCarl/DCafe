<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DCafe.Views.SuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DCafe.ViewModels"
    x:DataType="local:SuccessViewModel"
    BackgroundColor="#0D0705"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <StackLayout Padding="24,60,24,40" Spacing="0">

            <!-- ══ SUCCESS ICON + HEADING ════════════════════════════════════════ -->
            <Label Text="✅" FontSize="64" HorizontalOptions="Center" Margin="0,0,0,12" />

            <Label
                Text="Order Placed!"
                FontSize="28"
                FontAttributes="Bold"
                FontFamily="AstoreEczarSemiBold"
                TextColor="#C9A96E"
                HorizontalOptions="Center" />

            <Label
                Text="Your coffee is on its way ☕"
                FontSize="13"
                TextColor="#7A6650"
                FontFamily="AstoreEczarSemiBold"
                HorizontalOptions="Center"
                Margin="0,6,0,0" />

            <!-- Gold divider -->
            <BoxView HeightRequest="2" WidthRequest="50" Color="#C9A96E"
                     HorizontalOptions="Center" Margin="0,20,0,28" />

            <!-- ══ ORDER DETAILS CARD ══════════════════════════════════════════ -->
            <Frame
                Padding="20"
                BackgroundColor="#1A0E08"
                BorderColor="#2E1C0E"
                CornerRadius="20"
                Margin="0,0,0,16">
                <StackLayout Spacing="14">

                    <!-- Order ID -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Order ID"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Frame Grid.Column="1" Padding="8,4"
                               BackgroundColor="#C9A96E" BorderColor="Transparent"
                               CornerRadius="8">
                            <Label Text="{Binding DisplayOrderId}"
                                   FontSize="12" FontAttributes="Bold"
                                   FontFamily="AstoreEczarSemiBold"
                                   TextColor="#0D0705" />
                        </Frame>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Status -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Status"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Frame Grid.Column="1" Padding="8,4"
                               BackgroundColor="#1C3020" BorderColor="Transparent"
                               CornerRadius="8">
                            <Label Text="{Binding Status}"
                                   FontSize="12" FontAttributes="Bold"
                                   FontFamily="AstoreEczarSemiBold"
                                   TextColor="#5DBB7A" />
                        </Frame>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Placed at -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Placed at"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding PlacedAt}"
                               TextColor="#F5EDD8" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Recipient -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Name"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding FullName}"
                               TextColor="#F5EDD8" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Phone -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Phone"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding PhoneNumber}"
                               TextColor="#F5EDD8" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Payment -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Payment"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding PaymentMethod}"
                               TextColor="#F5EDD8" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E1C0E" />

                    <!-- Address (multi-line) -->
                    <StackLayout Spacing="4">
                        <Label Text="Delivering to"
                               TextColor="#7A6650" FontSize="12"
                               FontFamily="AstoreEczarSemiBold" />
                        <Label Text="{Binding Address}"
                               TextColor="#F5EDD8" FontSize="13"
                               FontFamily="AstoreEczarSemiBold"
                               LineBreakMode="WordWrap" />
                    </StackLayout>

                </StackLayout>
            </Frame>

            <!-- ══ ITEMS CARD ════════════════════════════════════════════════════ -->
            <Frame
                Padding="20"
                BackgroundColor="#1A0E08"
                BorderColor="#2E1C0E"
                CornerRadius="20"
                Margin="0,0,0,16">
                <StackLayout Spacing="10">
                    <Label Text="Items Ordered"
                           FontSize="14" FontAttributes="Bold"
                           FontFamily="AstoreEczarSemiBold"
                           TextColor="#F5EDD8" />
                    <BoxView HeightRequest="1" Color="#2E1C0E" />
                    <Label Text="{Binding ItemsSummary}"
                           TextColor="#C9A96E" FontSize="13"
                           FontFamily="AstoreEczarSemiBold"
                           LineBreakMode="WordWrap" />
                    <BoxView HeightRequest="1" Color="#2E1C0E" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Total"
                               FontAttributes="Bold" FontSize="15"
                               FontFamily="AstoreEczarSemiBold"
                               TextColor="#F5EDD8" />
                        <Label Grid.Column="1" Text="{Binding TotalAmount}"
                               FontAttributes="Bold" FontSize="16"
                               FontFamily="AstoreEczarSemiBold"
                               TextColor="#C9A96E" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- ══ BUTTONS ═══════════════════════════════════════════════════════ -->
            <Button
                Text="View My Orders"
                Command="{Binding ViewOrdersCommand}"
                BackgroundColor="#2E1C0E"
                TextColor="#C9A96E"
                FontAttributes="Bold"
                FontFamily="AstoreEczarSemiBold"
                FontSize="15"
                CornerRadius="14"
                HeightRequest="52"
                Margin="0,0,0,12" />

            <Button
                Text="Back to Home"
                Command="{Binding BackToHomeCommand}"
                BackgroundColor="#C9A96E"
                TextColor="#0D0705"
                FontAttributes="Bold"
                FontFamily="AstoreEczarSemiBold"
                FontSize="15"
                CornerRadius="14"
                HeightRequest="52" />

        </StackLayout>
    </ScrollView>
</ContentPage>
