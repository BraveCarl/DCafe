<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DCafe.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:DCafe.Converters"
    xmlns:local="clr-namespace:DCafe.ViewModels"
    xmlns:model="clr-namespace:DCafe.Models"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:DataType="local:LoginViewModel"
    BackgroundColor="#0D0705"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToPasswordIconConverter x:Key="BoolToPasswordIconConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="28,60,28,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo / Brand header -->
            <StackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,36">
                <Label
                    FontSize="13"
                    TextColor="#7A6650"
                    FontFamily="AstoreEczarSemiBold"
                    HorizontalOptions="Center"
                    Text="Welcome back ☕" />
                <Label
                    FontSize="36"
                    HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="D" TextColor="#C9A96E" FontAttributes="Bold" FontFamily="AstoreEczarSemiBold" />
                            <Span Text="Café" TextColor="#F5EDD8" FontAttributes="Bold" FontFamily="AstoreEczarSemiBold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <!-- Decorative gold line -->
                <BoxView
                    HeightRequest="2"
                    WidthRequest="40"
                    Color="#C9A96E"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0" />
            </StackLayout>

            <!-- Section label -->
            <Label
                Grid.Row="1"
                Text="Sign in to your account"
                FontFamily="AstoreEczarSemiBold"
                FontSize="13"
                TextColor="#7A6650"
                Margin="4,0,0,12" />

            <!-- Username field -->
            <Frame
                Grid.Row="2"
                Padding="16,0"
                BackgroundColor="#1A0E08"
                BorderColor="#2E1C0E"
                CornerRadius="14"
                HeightRequest="52"
                Margin="0,0,0,14">
                <Entry
                    FontFamily="AstoreEczarSemiBold"
                    FontSize="14"
                    Placeholder="Username"
                    PlaceholderColor="#4A3828"
                    Text="{Binding Username}"
                    TextColor="#F5EDD8"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center" />
            </Frame>

            <!-- Password field -->
            <Frame
                Grid.Row="3"
                Padding="16,0"
                BackgroundColor="#1A0E08"
                BorderColor="#2E1C0E"
                CornerRadius="14"
                HeightRequest="52"
                Margin="0,0,0,10">
                <AbsoluteLayout>
                    <Entry
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        FontFamily="AstoreEczarSemiBold"
                        FontSize="14"
                        IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                        Placeholder="Password"
                        PlaceholderColor="#4A3828"
                        Text="{Binding Password}"
                        TextColor="#F5EDD8"
                        BackgroundColor="Transparent" />
                    <Image
                        AbsoluteLayout.LayoutBounds="0.98,0.5,20,20"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        Source="{Binding IsPasswordVisible, Converter={StaticResource BoolToPasswordIconConverter}}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </AbsoluteLayout>
            </Frame>

            <!-- Forgot password -->
            <Label
                Grid.Row="4"
                FontAttributes="Bold"
                FontFamily="AstoreEczarSemiBold"
                FontSize="13"
                HorizontalOptions="End"
                Margin="0,0,4,28"
                Text="Forgot password?"
                TextColor="#C9A96E" />

            <!-- Login button -->
            <Button
                Grid.Row="5"
                Command="{Binding LoginCommand}"
                CornerRadius="14"
                HeightRequest="52"
                HorizontalOptions="FillAndExpand"
                BackgroundColor="#C9A96E"
                TextColor="#0D0705"
                FontAttributes="Bold"
                FontFamily="AstoreEczarSemiBold"
                FontSize="16"
                Text="Sign In"
                Margin="0,0,0,24" />

            <!-- Register prompt -->
            <StackLayout
                Grid.Row="6"
                Orientation="Horizontal"
                HorizontalOptions="Center"
                Spacing="4">
                <Label
    FontAttributes="Bold"
    FontFamily="AstoreEczarSemiBold"
    FontSize="13"
    Text="Register"
    TextColor="#C9A96E"
    VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
