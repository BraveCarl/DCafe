<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiStoreApp.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:converters="clr-namespace:MauiStoreApp.Converters"
    xmlns:local="clr-namespace:MauiStoreApp.ViewModels"
    xmlns:model="clr-namespace:MauiStoreApp.Models"
    xmlns:modelroot="clr-namespace:MauiStoreApp.Models"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:DataType="local:CategoryPageViewModel"
    BackgroundColor="#0D0705">

    <Shell.TitleView>
        <Grid HorizontalOptions="FillAndExpand" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackLayout VerticalOptions="Center">
                <Label
                    Text="Browsing"
                    FontSize="10"
                    TextColor="#7A6650"
                    FontFamily="AstoreEczarSemiBold"
                    HorizontalOptions="Center"/>
                <Label
                    FontSize="18"
                    FontAttributes="Bold"
                    FontFamily="AstoreEczarSemiBold"
                    HorizontalOptions="Center"
                    Text="{Binding Category.Name, Converter={StaticResource FirstLetterUppercaseConverter}}"
                    TextColor="#F5EDD8"
                    VerticalOptions="Center" />
            </StackLayout>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior Command="{Binding InitCommand}" EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FirstLetterUppercaseConverter x:Key="FirstLetterUppercaseConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: count + sort -->
            <Grid
                Grid.Row="0"
                Padding="16,14,16,10"
                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Count badge -->
                <Frame
                    Grid.Column="0"
                    Padding="10,5"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    CornerRadius="10"
                    HorizontalOptions="Start">
                    <Label
                        FontAttributes="Bold"
                        FontFamily="AstoreEczarSemiBold"
                        FontSize="13"
                        Text="{Binding Products.Count, StringFormat='{0} items'}"
                        TextColor="#C9A96E" />
                </Frame>

                <!-- Sort control -->
                <Frame
                    Grid.Column="1"
                    Padding="10,5"
                    BackgroundColor="#1A0E08"
                    BorderColor="#2E1C0E"
                    CornerRadius="10">
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <Label
                            FontFamily="AstoreEczarSemiBold"
                            FontSize="12"
                            Text="Sort:"
                            TextColor="#7A6650"
                            VerticalTextAlignment="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="AstoreEczarSemiBold"
                            FontSize="12"
                            TextColor="#F5EDD8"
                            VerticalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding SortOrder}" TargetType="Label" Value="asc">
                                    <Setter Property="Text" Value="Price ↑" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SortOrder}" TargetType="Label" Value="desc">
                                    <Setter Property="Text" Value="Price ↓" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SortProductsCommand}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SortProductsCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>
            </Grid>

            <!-- Divider -->
            <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="#2E1C0E" />

            <!-- Products grid -->
            <CollectionView
                Grid.Row="1"
                Margin="12,8,12,20"
                ItemsSource="{Binding Products}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Product">
                        <Frame
                            Padding="0"
                            BackgroundColor="#1A0E08"
                            BorderColor="#2E1C0E"
                            CornerRadius="16"
                            HasShadow="False">
                            <StackLayout>
                                <!-- Image area -->
                                <Frame
                                    Padding="0"
                                    BackgroundColor="#120A04"
                                    BorderColor="Transparent"
                                    CornerRadius="0"
                                    HeightRequest="110"
                                    HasShadow="False">
                                    <Image
                                        Margin="16"
                                        Aspect="AspectFit"
                                        Source="{Binding Image}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:CategoryPageViewModel}}, Path=ProductTappedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Frame>

                                <!-- Info -->
                                <StackLayout Padding="10,8,10,12" Spacing="4">
                                    <!-- Stars + rating -->
                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                        <Image
                                            Source="star_filled_yellow.svg"
                                            HeightRequest="12"
                                            WidthRequest="12"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{Binding Rating.Rate}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            FontFamily="AstoreEczarSemiBold"
                                            TextColor="#C9A96E"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <!-- Title -->
                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="12"
                                        FontFamily="AstoreEczarSemiBold"
                                        TextColor="#F5EDD8"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2" />

                                    <!-- Divider -->
                                    <BoxView HeightRequest="1" Color="#2E1C0E" Margin="0,2" />

                                    <!-- Price -->
                                    <Label
                                        Text="{Binding Price, StringFormat='₱{0:F2}'}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        FontFamily="AstoreEczarSemiBold"
                                        TextColor="#C9A96E" />
                                </StackLayout>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:CategoryPageViewModel}}, Path=ProductTappedCommand}"
                                        CommandParameter="{Binding .}" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading indicators -->
            <ActivityIndicator
                Grid.RowSpan="2"
                HorizontalOptions="CenterAndExpand"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="CenterAndExpand"
                Color="#C9A96E" />

            <ActivityIndicator
                Grid.RowSpan="2"
                HorizontalOptions="CenterAndExpand"
                IsRunning="{Binding IsBusyWithSorting}"
                IsVisible="{Binding IsBusyWithSorting}"
                VerticalOptions="CenterAndExpand"
                Color="#C9A96E" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
